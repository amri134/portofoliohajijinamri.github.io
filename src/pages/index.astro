---
import Header from "../components/Header.astro";
import Profile from "../components/Profile.astro";
import Experience from "../components/Experience.astro";
import Achievements from "../components/Achievements.astro";
import Projects from "../components/Projects.astro";
import Certificates from "../components/Certificates.astro";
import Contact from "../components/Contact.astro";
import Skills from "../components/Skills.astro";
import "../../style.css";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portfolio profesional Hajijin Amri, mahasiswa Teknik Informatika dengan fokus networking, cloud computing, data science, dan computer vision." />
    <title>Hajijin Amri — Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="dark">
    <Header />
    <main><Profile /><Experience /><Achievements /><Projects /><Skills /><Certificates /><Contact /></main>
    <footer>© 2026 Hajijin Amri. Dibuat dengan sepenuh hati.</footer>
    <dialog class="certificate-preview"><button class="close-preview" aria-label="Tutup">×</button><p class="preview-issuer"></p><h2 class="preview-title"></h2><img class="preview-document" alt="Pratinjau sertifikat" /><button class="open-certificate-details">Lihat detail sertifikat →</button></dialog>
    <dialog class="certificate-modal"><button class="close-modal" aria-label="Tutup">×</button><p class="modal-issuer"></p><h2 class="modal-title"></h2><div class="modal-meta"><p>Diterbitkan <strong></strong></p><p>Berlaku hingga <strong></strong></p></div><img class="modal-document" alt="Dokumen sertifikat" /></dialog>
    <dialog class="more-certificates-modal"><button class="close-more-cert" aria-label="Tutup">×</button><h2>More Sertifikat</h2><p>Pilih profil untuk melihat sertifikat lainnya.</p><a class="more-cert-link" href="https://www.linkedin.com/in/hajijin-amri-5509b0206/" target="_blank" rel="noreferrer">LinkedIn →</a><a class="more-cert-link" href="https://jinam.app" target="_blank" rel="noreferrer">Transkrip dan badge →</a></dialog>
    <script src="/script.js" is:inline></script>
  </body>
</html>
