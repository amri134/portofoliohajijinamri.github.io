---
import { BrainCircuit, Cable, CloudCog, Database, FileCheck2, Network, ServerCog } from "@lucide/astro";

const groups = [
  { title: "Jaringan & Infrastruktur", icon: Network, items: ["Network Administration", "Routing & Switching", "Instalasi & Pengkabelan", "Troubleshooting Jaringan", "Monitoring Jaringan", "Cisco Networking Academy"] },
  { title: "Sistem & Cloud", icon: ServerCog, items: ["Linux Administration", "Cloud Computing", "Google Cloud", "REST API", "Deployment Model", "Dokumentasi Teknis"] },
  { title: "Data & Computer Vision", icon: BrainCircuit, items: ["Data Management", "Data Engineering", "Image Classification", "Convolutional Neural Network", "MobileNet", "MTCNN", "Model Inference"] },
  { title: "Administrasi Profesional", icon: FileCheck2, items: ["Administrasi Data", "Pengarsipan Dokumen", "Validasi Data", "Integrasi API & Website", "Pengujian Sistem", "Technical Troubleshooting"] },
];
---

<section id="keahlian" class="stack-section">
  <header class="showcase-heading">
    <p class="section-kicker">Kompetensi</p>
    <h2>Keahlian</h2>
    <p>Perangkat, teknologi, dan kemampuan yang saya gunakan untuk membangun serta mendukung solusi digital.</p>
  </header>

  <div class="skill-accordions">
    {groups.map((group, index) => {
      const Icon = group.icon;
      return (
        <details class="skill-accordion" open={index === 0}>
          <summary>
            <span class="skill-number">{index + 1}</span>
            <span class="skill-title"><Icon size={24} />{group.title}</span>
            <span class="skill-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="skill-icon-grid">
            {group.items.map((item, itemIndex) => (
              <div class="skill-icon-card" title={item}>
                <span class="skill-icon-wrap"><Icon size={25} strokeWidth={1.8} /></span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </details>
      );
    })}
  </div>
</section>
