---
import { ArrowUpRight } from "@lucide/astro";
import { projects } from "../data/projects";
---

<section id="proyek" class="showcase-section">
  <header class="showcase-heading">
    <p class="section-kicker">Portofolio terpilih</p>
    <h2>Proyek</h2>
    <p>Empat karya unggulan yang menunjukkan penerapan keahlian pada security, cloud, data, dan pengembangan aplikasi.</p>
  </header>

  <div class="showcase-grid">
    {projects.slice(0, 4).map((project) => {
      const Icon = project.icon;
      return (
        <article class:list={["showcase-card", `tone-${project.tone}`]}>
          <div class="project-visual" aria-hidden="true"><span class="visual-orbit orbit-one"></span><span class="visual-orbit orbit-two"></span><Icon size={68} strokeWidth={1.35} /><span class="visual-grid"></span></div>
          <div class="showcase-card-body">
            <p class="showcase-label">{project.label}</p><h3>{project.title}</h3><p class="showcase-description">{project.summary ?? project.description}</p>
            <div class="showcase-tags" aria-label="Teknologi yang digunakan">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            <div class="showcase-actions" style="gap: 16px; flex-wrap: wrap;">
              {project.links?.map((link) => <a class="showcase-link" href={link.href} target="_blank" rel="noreferrer">{link.label}<ArrowUpRight size={17} /></a>)}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="all-projects-action"><a class="all-projects-link" href="/proyek">Lihat semua proyek <ArrowUpRight size={18} /></a></div>
</section>

<style>
  .showcase-description { text-align: justify; text-justify: inter-word; }
  .all-projects-action { display: flex; justify-content: center; margin-top: 34px; }
  .all-projects-link { display: inline-flex; align-items: center; gap: 8px; padding: 13px 18px; border: 1px solid var(--accent); border-radius: 999px; color: var(--accent); font-weight: 800; text-decoration: none; }
  .all-projects-link:hover { background: var(--accent); color: #fff; }
</style>
